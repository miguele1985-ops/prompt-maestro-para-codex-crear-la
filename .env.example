# Cambia este valor cuando tengas el dominio definitivo.
# Ejemplo: NEXT_PUBLIC_SITE_URL=https://tudominio.com
NEXT_PUBLIC_SITE_URL=https://dominio-pendiente.example
NEXT_PUBLIC_FORM_PROVIDER=
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
RESEND_API_KEY=
BREVO_API_KEY=
PLAUSIBLE_DOMAIN=
UMAMI_WEBSITE_ID=
GOOGLE_ANALYTICS_ID=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-por-una-contrasena-larga
ADMIN_TOKEN=cambiar-por-un-token-largo
ADMIN_SESSION_SECRET=cambiar-por-otro-secreto-largo

# Contadores reales del panel de administracion.
# Crear un namespace KV en Cloudflare y un API token con permiso KV Storage Edit.
COUNTERS_KV_ACCOUNT_ID=
COUNTERS_KV_NAMESPACE_ID=
COUNTERS_KV_API_TOKEN=

# Contenido editable del panel de administracion.
# Puedes reutilizar el mismo KV de contadores o crear otro namespace.
# Si se dejan vacias, se usaran las variables COUNTERS_KV_* o CLOUDFLARE_*.
ADMIN_CONTENT_KV_ACCOUNT_ID=
ADMIN_CONTENT_KV_NAMESPACE_ID=
ADMIN_CONTENT_KV_API_TOKEN=
